diff --git a/src/unlock/targets.h b/src/unlock/targets.h
new file mode 100644
index 0000000..0a5a210
--- /dev/null
+++ b/src/unlock/targets.h
@@ -0,0 +1,14 @@
+#pragma once
+/* Per-card build targeting.
+   GU_TARGET_BUS 0xffff keeps the stock "any location" behaviour.
+   GU_DIR_A / GU_DIR_B select a per-card payload directory on the boot volume. */
+#ifndef GU_TARGET_BUS
+#define GU_TARGET_BUS 0xffffU
+#endif
+#if defined(GU_DIR_A)
+#define GU_VOLUME_DIR L"\\RTX-UNLOCK-A"
+#elif defined(GU_DIR_B)
+#define GU_VOLUME_DIR L"\\RTX-UNLOCK-B"
+#else
+#define GU_VOLUME_DIR L"\\RTX-UNLOCK"
+#endif
