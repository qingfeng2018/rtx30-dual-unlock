diff --git a/src/launcher/launcher.c b/src/launcher/launcher.c
new file mode 100644
index 0000000..c39a0fe
--- /dev/null
+++ b/src/launcher/launcher.c
@@ -0,0 +1,129 @@
+/* RTX30 dual-card launcher: runs one unlock child per target card, in order.
+   Children are the same build with a different -DGU_TARGET_BUS / GU_DIR_x. */
+#include <Uefi.h>
+#include <Protocol/LoadedImage.h>
+#include <Protocol/DevicePath.h>
+
+#define CHILD_COUNT 2
+
+static EFI_SYSTEM_TABLE *ST;
+static EFI_HANDLE ImageHandle;
+
+static CHAR16 *Children[CHILD_COUNT] = {L"\\EFI\\BOOT\\RTX30-2.EFI", L"\\EFI\\BOOT\\RTX30-3.EFI"};
+
+static VOID Say(CHAR16 *Text) {
+  if (ST && ST->ConOut && ST->ConOut->OutputString) ST->ConOut->OutputString(ST->ConOut, Text);
+}
+
+static VOID SayStatus(EFI_STATUS Status) {
+  static const CHAR16 Digits[] = L"0123456789abcdef";
+  CHAR16 Buffer[] = L"0x0000000000000000\r\n";
+  for (UINTN i = 0; i < 16; i++) Buffer[2 + i] = Digits[((UINT64)Status >> ((15 - i) * 4)) & 15];
+  Say(Buffer);
+}
+
+static UINTN TextLength(const CHAR16 *Text) {
+  UINTN n = 0;
+  while (Text[n]) n++;
+  return n;
+}
+
+static UINTN NodeLength(const EFI_DEVICE_PATH_PROTOCOL *Node) {
+  return (UINTN)Node->Length[0] | ((UINTN)Node->Length[1] << 8);
+}
+
+/* Append a file path node to the volume device path, which is what LoadImage expects. */
+static EFI_STATUS BuildFilepath(EFI_DEVICE_PATH_PROTOCOL *VolumePath, const CHAR16 *Name,
+                                EFI_DEVICE_PATH_PROTOCOL **Out) {
+  UINT8 *Raw = (UINT8 *)VolumePath;
+  UINTN Offset = 0;
+  BOOLEAN Ended = FALSE;
+  for (UINTN i = 0; i < 64; i++) {
+    EFI_DEVICE_PATH_PROTOCOL *Node = (EFI_DEVICE_PATH_PROTOCOL *)(Raw + Offset);
+    UINTN Length = NodeLength(Node);
+    if (Length < 4 || Length > 4096 - Offset) return EFI_VOLUME_CORRUPTED;
+    if (Node->Type == END_DEVICE_PATH_TYPE) {
+      Ended = TRUE;
+      break;
+    }
+    Offset += Length;
+  }
+  if (!Ended || Offset == 0) return EFI_VOLUME_CORRUPTED;
+
+  UINTN Chars = TextLength(Name) + 1;
+  UINTN NameBytes = Chars * sizeof(CHAR16);
+  UINTN FileNodeLength = 4 + NameBytes;
+  UINTN Total = Offset + FileNodeLength + 4;
+  UINT8 *Buffer = NULL;
+  EFI_STATUS Status = ST->BootServices->AllocatePool(EfiLoaderData, Total, (VOID **)&Buffer);
+  if (EFI_ERROR(Status) || !Buffer) return EFI_OUT_OF_RESOURCES;
+  for (UINTN i = 0; i < Offset; i++) Buffer[i] = Raw[i];
+  UINT8 *Node = Buffer + Offset;
+  Node[0] = 0x04; /* MEDIA_DEVICE_PATH */
+  Node[1] = 0x04; /* MEDIA_FILEPATH_DP */
+  Node[2] = (UINT8)(FileNodeLength & 0xff);
+  Node[3] = (UINT8)(FileNodeLength >> 8);
+  for (UINTN i = 0; i < Chars; i++) {
+    Node[4 + i * 2] = (UINT8)(Name[i] & 0xff);
+    Node[5 + i * 2] = (UINT8)((Name[i] >> 8) & 0xff);
+  }
+  UINT8 *End = Node + FileNodeLength;
+  End[0] = 0x7f; /* END_DEVICE_PATH_TYPE */
+  End[1] = 0xff; /* END_ENTIRE_DEVICE_PATH_SUBTYPE */
+  End[2] = 4;
+  End[3] = 0;
+  *Out = (EFI_DEVICE_PATH_PROTOCOL *)Buffer;
+  return EFI_SUCCESS;
+}
+
+static EFI_STATUS RunChild(EFI_DEVICE_PATH_PROTOCOL *VolumePath, const CHAR16 *Name) {
+  EFI_DEVICE_PATH_PROTOCOL *Path = NULL;
+  EFI_STATUS Status = BuildFilepath(VolumePath, Name, &Path);
+  if (EFI_ERROR(Status)) return Status;
+  EFI_HANDLE Child = NULL;
+  Status = ST->BootServices->LoadImage(FALSE, ImageHandle, Path, NULL, 0, &Child);
+  ST->BootServices->FreePool(Path);
+  if (EFI_ERROR(Status) || !Child) return EFI_ERROR(Status) ? Status : EFI_LOAD_ERROR;
+  return ST->BootServices->StartImage(Child, NULL, NULL);
+}
+
+EFI_STATUS EFIAPI efi_main(EFI_HANDLE Image, EFI_SYSTEM_TABLE *Table) {
+  ST = Table;
+  ImageHandle = Image;
+  Say(L"\r\nRTX30 dual-card launcher v1\r\n"
+      L"Two passes in this power cycle, one per RTX 3080. Do not remove the USB.\r\n");
+  EFI_GUID LoadedGuid = EFI_LOADED_IMAGE_PROTOCOL_GUID;
+  EFI_GUID PathGuid = EFI_DEVICE_PATH_PROTOCOL_GUID;
+  EFI_LOADED_IMAGE_PROTOCOL *Loaded = NULL;
+  EFI_STATUS Status = Table->BootServices->HandleProtocol(Image, &LoadedGuid, (VOID **)&Loaded);
+  if (EFI_ERROR(Status) || !Loaded || !Loaded->DeviceHandle) {
+    Say(L"launcher: no loaded-image device\r\n");
+    return EFI_ERROR(Status) ? Status : EFI_NOT_FOUND;
+  }
+  EFI_DEVICE_PATH_PROTOCOL *VolumePath = NULL;
+  Status = Table->BootServices->HandleProtocol(Loaded->DeviceHandle, &PathGuid,
+                                               (VOID **)&VolumePath);
+  if (EFI_ERROR(Status) || !VolumePath) {
+    Say(L"launcher: no volume device path\r\n");
+    return EFI_ERROR(Status) ? Status : EFI_NOT_FOUND;
+  }
+  for (UINTN i = 0; i < CHILD_COUNT; i++) {
+    CHAR16 Line[] = L"pass X of 2: loading child\r\n";
+    Line[5] = (CHAR16)(L'1' + i);
+    Say(Line);
+    Status = RunChild(VolumePath, Children[i]);
+    if (EFI_ERROR(Status)) {
+      CHAR16 Failed[] = L"pass X failed, status ";
+      Failed[5] = (CHAR16)(L'1' + i);
+      Say(Failed);
+      SayStatus(Status);
+      Say(L"Stop here: power off physically, do not continue into Windows.\r\n");
+      return Status;
+    }
+    Say(L"pass finished without error\r\n");
+  }
+  Say(L"Both passes completed. Returning to firmware: choose Windows Boot Manager now.\r\n"
+      L"Do not reboot; a reboot discards the unlock.\r\n");
+  Table->BootServices->Stall(5000000);
+  return EFI_SUCCESS;
+}
